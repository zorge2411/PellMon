# PellMon Example Configuration for Docker
# Copy this file to config/pellmon.conf and customize
#
# Most settings live in config/conf.d/*.conf (copied from src/conf.d, see DEPLOY-PI.md).
# Both daemons read every *.conf file under config_dir after this file, so:
#   - polling and graph sections ([pollvalues], [rrd_ds_names], [rrd_ds_types])
#     come from conf.d/database.conf
#   - the default enabled plugins come from conf.d/enabled_plugins.conf
#   - plugin settings (e.g. the Scotte serial port) come from conf.d/plugins/*.conf

[conf]
# Database file (inside container volume)
database = /var/lib/pellmon/pellmon.rrd

# The Scotte serial port is NOT set here. Set `serialport` in
# conf.d/plugins/scottecom.conf under [plugin_ScotteCom].

# Config directory for additional plugin configs
config_dir = /etc/pellmon/conf.d

# Main application log file (referenced by LogViewer)
logfile = /var/log/pellmon/pellmon.log

[weblog]
accesslog = /var/log/pellmon/access.log
errorlog = /var/log/pellmon/error.log

[authentication]
# Each line is: <username> = <password hash>
# Passwords MUST be stored as PBKDF2 hashes; plaintext passwords are rejected.
# Generate a hash with:
# python3 -c "from Pellmonweb.auth import hash_password; print(hash_password('yourpassword'))"
# admin = pbkdf2:sha256:600000$...

[enabled_plugins]
# Format: <any key> = <PluginName>. The VALUE is the plugin name; the key is arbitrary.
# (Not "ScotteCom = yes": that would enable a plugin called "yes", i.e. nothing.)
# Defaults come from conf.d/enabled_plugins.conf. Add more here, for example:
# p02 = CustomAlarms
# p04 = Calculate

[plugin_settings]
# Directory where plugins are located
# plugin_dirs = /usr/lib/pellmon/plugins
