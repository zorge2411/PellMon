# Environment variables for PellMon Docker deployment
# Copy this to .env and customize as needed

# Timezone
TZ=Europe/Stockholm

# Web interface port
PELLMON_WEB_PORT=8081

# WebSocket port (if enabled)
PELLMON_WS_PORT=8082

# Address pellmonweb binds to inside the container (0.0.0.0 required for Docker port publishing)
PELLMON_WEB_HOST=0.0.0.0

# Group ID that owns your serial adapter (Scotte burners). The daemon runs as a non-root user and
# needs this group to open the port. Find it on the host with:  stat -c %g /dev/ttyUSB0
# 20 is "dialout" on Debian/Raspberry Pi OS; some adapters use another group (e.g. 46).
# If this is wrong the daemon logs "Permission denied" for the port and falls back to fake data.
SERIAL_GID=20
